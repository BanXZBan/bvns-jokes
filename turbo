<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Mending Mana? - Edisi Lokal</title>
  <!-- Tailwind CSS via CDN biar gampang -->
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* Custom style untuk efek kartu terbalik/transisi */
    .btn-choice {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
  </style>
</head>
<body class="bg-slate-900 text-white min-h-screen flex flex-col items-center justify-center p-4 font-sans">

  <!-- Header -->
  <header class="text-center mb-8">
    <span class="bg-indigo-500/10 text-indigo-400 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-widest border border-indigo-500/20">
      Game Dilema Lokal
    </span>
    <h1 class="text-4xl md:text-5xl font-extrabold mt-3 bg-gradient-to-r from-indigo-400 to-pink-500 bg-clip-text text-transparent">
      Mending Mana?
    </h1>
    <p class="text-slate-400 text-sm mt-2">Pilih salah satu dan lihat pilihan warga internet lainnya!</p>
  </header>

  <!-- Container Pilihan -->
  <main class="w-full max-w-3xl grid grid-cols-1 md:grid-cols-2 gap-4 relative">
    
    <!-- Pilihan A -->
    <button id="btnA" onclick="vote('a')" class="btn-choice bg-slate-800 border-2 border-slate-700 hover:border-indigo-500 rounded-2xl p-6 min-h-[220px] flex flex-col items-center justify-center text-center cursor-pointer group shadow-lg hover:shadow-indigo-500/10">
      <p id="textA" class="text-lg font-semibold text-slate-200 group-hover:text-white mb-4">Loading...</p>
      <div id="resultA" class="hidden flex-col items-center">
        <span id="percentA" class="text-5xl font-black text-indigo-400">0%</span>
        <span id="countA" class="text-xs text-slate-500 mt-1">0 suara</span>
      </div>
    </button>

    <!-- Visual 'VS' di Tengah -->
    <div class="hidden md:flex absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-slate-900 border border-slate-700 w-10 h-10 rounded-full items-center justify-center text-xs font-bold text-slate-400 z-10 pointer-events-none">
      VS
    </div>

    <!-- Pilihan B -->
    <button id="btnB" onclick="vote('b')" class="btn-choice bg-slate-800 border-2 border-slate-700 hover:border-pink-500 rounded-2xl p-6 min-h-[220px] flex flex-col items-center justify-center text-center cursor-pointer group shadow-lg hover:shadow-pink-500/10">
      <p id="textB" class="text-lg font-semibold text-slate-200 group-hover:text-white mb-4">Loading...</p>
      <div id="resultB" class="hidden flex-col items-center">
        <span id="percentB" class="text-5xl font-black text-pink-400">0%</span>
        <span id="countB" class="text-xs text-slate-500 mt-1">0 suara</span>
      </div>
    </button>

  </main>

  <!-- Tombol Next -->
  <div class="mt-8 h-12">
    <button id="btnNext" onclick="nextQuestion()" class="hidden bg-gradient-to-r from-indigo-500 to-pink-500 text-white font-bold py-3 px-8 rounded-full shadow-lg hover:opacity-90 transition duration-200 transform hover:scale-105 active:scale-95">
      Pertanyaan Selanjutnya →
    </button>
  </div>

  <!-- JavaScript Logic -->
  <script>
    // Data dummy dilema lokal
    const dilemmas = [
      {
        id: 1,
        a: "Macet 3 jam tapi di dalam mobil dingin ber-AC",
        b: "Jalanan lancar tapi naik angkot penuh & kepanasan",
        votesA: 1240,
        votesB: 620
      },
      {
        id: 2,
        a: "Makan di warteg enak tapi banyak lalat lewat",
        b: "Makan di resto mahal estetik tapi rasanya hambar",
        votesA: 890,
        votesB: 410
      },
      {
        id: 3,
        a: "Lupa bawa dompet pas mau bayar parkir",
        b: "HP lowbat 1% pas mau bayar pakai QRIS",
        votesA: 310,
        votesB: 950
      },
      {
        id: 4,
        a: "Tetangga karokean lagu dangdut tiap malam minggu",
        b: "Tetangga piara ayam jantan yang berkokok jam 3 subuh",
        votesA: 530,
        votesB: 780
      }
    ];

    let currentIndex = 0;
    let hasVoted = false;

    function loadQuestion() {
      hasVoted = false;
      const current = dilemmas[currentIndex];

      // Reset Tampilan
      document.getElementById('textA').innerText = current.a;
      document.getElementById('textB').innerText = current.b;

      document.getElementById('resultA').classList.add('hidden');
      document.getElementById('resultA').classList.remove('flex');
      document.getElementById('resultB').classList.add('hidden');
      document.getElementById('resultB').classList.remove('flex');

      document.getElementById('btnNext').classList.add('hidden');

      // Enable Tombol & Reset Style
      const btnA = document.getElementById('btnA');
      const btnB = document.getElementById('btnB');
      
      btnA.disabled = false;
      btnB.disabled = false;
      btnA.className = "btn-choice bg-slate-800 border-2 border-slate-700 hover:border-indigo-500 rounded-2xl p-6 min-h-[220px] flex flex-col items-center justify-center text-center cursor-pointer group shadow-lg";
      btnB.className = "btn-choice bg-slate-800 border-2 border-slate-700 hover:border-pink-500 rounded-2xl p-6 min-h-[220px] flex flex-col items-center justify-center text-center cursor-pointer group shadow-lg";
    }

    function vote(option) {
      if (hasVoted) return;
      hasVoted = true;

      const current = dilemmas[currentIndex];

      // Tambah vote
      if (option === 'a') current.votesA++;
      if (option === 'b') current.votesB++;

      const total = current.votesA + current.votesB;
      const percentA = Math.round((current.votesA / total) * 100);
      const percentB = Math.round((current.votesB / total) * 100);

      // Tampilkan Hasil
      document.getElementById('percentA').innerText = percentA + '%';
      document.getElementById('countA').innerText = current.votesA.toLocaleString() + ' warga';
      
      document.getElementById('percentB').innerText = percentB + '%';
      document.getElementById('countB').innerText = current.votesB.toLocaleString() + ' warga';

      document.getElementById('resultA').classList.remove('hidden');
      document.getElementById('resultA').classList.add('flex');
      document.getElementById('resultB').classList.remove('hidden');
      document.getElementById('resultB').classList.add('flex');

      // Highlight pilihan user
      const btnA = document.getElementById('btnA');
      const btnB = document.getElementById('btnB');

      btnA.disabled = true;
      btnB.disabled = true;

      if(option === 'a') {
        btnA.classList.add('border-indigo-500', 'bg-indigo-950/30');
        btnB.classList.add('opacity-50');
      } else {
        btnB.classList.add('border-pink-500', 'bg-pink-950/30');
        btnA.classList.add('opacity-50');
      }

      // Munculkan tombol next
      document.getElementById('btnNext').classList.remove('hidden');
    }

    function nextQuestion() {
      // Ambil index acak yang berbeda
      let newIndex;
      do {
        newIndex = Math.floor(Math.random() * dilemmas.length);
      } while (newIndex === currentIndex && dilemmas.length > 1);
      
      currentIndex = newIndex;
      loadQuestion();
    }

    // Jalankan saat pertama load
    loadQuestion();
  </script>
</body>
</html>

